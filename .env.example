# ── Gemini / Serper API keys (required for real pipeline) ──────────────────────
GOOGLE_API_KEY=your_google_api_key_here
SERPER_API_KEY=your_serper_api_key_here

# ── Groq fallback (optional) ───────────────────────────────────────────────────
# When set, Groq (llama-3.3-70b-versatile) is used as an automatic per-call
# fallback if Gemini returns a quota / rate-limit / unavailability error.
# Image-bearing plan calls always remain on Gemini (Groq has no vision API).
# Leave blank or omit to disable the fallback entirely.
GROQ_API_KEY=your_groq_api_key_here

# ── Database ───────────────────────────────────────────────────────────────────
# PostgreSQL (production):
#   DATABASE_URL=postgresql://user:password@host:5432/truthmesh
# SQLite (local dev, no install required):
DATABASE_URL=sqlite:///./truthmesh.db

# ── Authentication ─────────────────────────────────────────────────────────────
# Generate a secure random string: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=CHANGE_ME_TO_A_RANDOM_64_CHAR_STRING
JWT_ALGORITHM=HS256
JWT_EXPIRE_DAYS=7

# ── Vector Store ───────────────────────────────────────────────────────────────
# "fake"     = InMemoryVectorStore + FakeEmbeddings (dev / test, no extra install)
# "pgvector" = PostgreSQL pgvector + Google text-embedding-004 (production)
# Note: "pgvector" requires DATABASE_URL to point to a PostgreSQL db with the
# pgvector extension enabled (e.g., Supabase free tier), and GOOGLE_API_KEY.
VECTOR_BACKEND=fake

# ── CORS ───────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins, or * for all
CORS_ORIGINS=*

# ── Environment ────────────────────────────────────────────────────────────────
ENVIRONMENT=development
